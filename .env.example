# GapZero — Environment Configuration

# Server Port & Mode
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Anthropic Claude API (Required for production AI features)
# If omitted, GapZero runs in high-fidelity intelligent simulation mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Supabase PostgreSQL & Auth (Required for cloud database persistence)
# If omitted, GapZero operates in isolated local storage mode
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub API (Optional, increases GitHub portfolio analysis rate limits)
GITHUB_TOKEN=

# JWT & Authentication Secret
JWT_SECRET=gapzero-super-secure-production-jwt-secret-replace-with-random-hex
